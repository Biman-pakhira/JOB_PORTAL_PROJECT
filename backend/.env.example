# Server Configuration
PORT=5001

# MongoDB Connection String (Prisma MongoDB Provider)
# Replace with your MongoDB connection string (e.g., MongoDB Atlas or local MongoDB)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/job_portal?retryWrites=true&w=majority"

# JWT Secret Key for Session Tokens
JWT_SECRET="your_jwt_secret_key_change_in_production_12345"

# Admin Setup Master Key (used for initializing admin account via /api/admin/setup)
ADMIN_MASTER_KEY="admin_master_secret_key"

# Google Auth Client ID
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Frontend URL (allowed for CORS)
FRONTEND_URL="http://localhost:3000"
